# Copy this file to ".env" and fill in ONE key.  (No paid OpenAI is used.)

# ---- PRIMARY: Google Gemini (recommended) --------------------------------- #
# Get a FREE key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default Gemini model (free, strong multilingual). Override in the UI if you like.
LLM_MODEL=gemini-2.0-flash

# ---- OPTIONAL FALLBACK: OpenRouter ---------------------------------------- #
# Used automatically only if GEMINI_API_KEY is NOT set.
# Free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_APP_TITLE=Multilingual Lyric Generator (PS-C2)
# OPENROUTER_SITE_URL=http://localhost:8501

# ---- OPTIONAL: Kaggle creds to also ingest the Hindi Bollywood lyrics set -- #
# (Not required — the app works with the HF datasets + bundled samples.)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
